<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\MushTown.Shared\MushTown.Shared.csproj" />
    <ProjectReference Include="..\WzComparerR2\WzComparerR2.WzLib\WzComparerR2.WzLib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Windows MP3 decoder (Media Foundation): the managed one (NLayer)
         mis-decodes these WZ tracks. This tool only runs on Windows and is
         not shipped; NAudio is MIT licensed. -->
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Export\lists\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- System.Drawing (png saving) is Windows-only, and this dev tool only runs on Windows. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

</Project>
